#!/bin/bash
#PBS -q auto_free
#PBS -o logs/hmcnc_smc.out
#PBS -e logs/hmcnc_smc.err
#PBS -N hmcnc_smc
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=4:mpiprocs=1:ompthreads=4:ngpus=1:mem=32gb

set -e   # so a python crash shows up as a failed job, not a silent success

cd $PBS_O_WORKDIR;
mkdir -p logs

module load cuda12.4/toolkit/12.4.1
source /scratch/e1498138/anaconda3/bin/activate egb-multi

# don't let JAX grab most of the GPU up front -- avoids OOM when sharing the card
export XLA_PYTHON_CLIENT_PREALLOCATE=false

export N_PARTICLES=200
export NUM_MCMC=5
export TARGET_ESS=0.5
export INJ=/scratch/e1498138/eGB-multi/sangria_hmcnc_10x.h5

python /home/svu/e1498138/localgit/eGB-multi/run/hmcnc_smc.py

echo "Job completed at $(date)"
