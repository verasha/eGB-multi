#!/bin/bash
#PBS -q auto_free
#PBS -o /home/svu/e1498138/localgit/eGB-multi/run/logs/hmcnc_rec_true.out
#PBS -e /home/svu/e1498138/localgit/eGB-multi/run/logs/hmcnc_rec_true.err
#PBS -N hmcnc_rec
#PBS -l walltime=12:00:00
#PBS -l select=1:ncpus=4:mpiprocs=1:ompthreads=4:ngpus=1:mem=32gb

# Change to the working directory
cd $PBS_O_WORKDIR;

# Create logs directory if it doesn't exist
mkdir -p /home/svu/e1498138/localgit/eGB-multi/run/logs

# Load required modules
module load cuda12.4/toolkit/12.4.1

# Activate conda environment
source /scratch/e1498138/anaconda3/bin/activate egb-multi

# Run the nested-sampling recovery script
python /home/svu/e1498138/localgit/eGB-multi/run/hmcnc_rec.py

echo "Job completed at $(date)"
